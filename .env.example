NODE_ENV=development
PORT=3001
# Application, development seed and local API data.
DATABASE_URL=postgresql://vacinekids:vacinekids_dev@localhost:5432/vacinekids_demo?schema=public
# Tests: both URLs MUST target the same loopback host/port and vacinekids_demo database.
# The only permitted URL query parameter locally is schema (public / integration_test).
# Neon and ALL remote hosts are rejected before connecting. Never copy production URLs here.
TEST_DATABASE_URL=postgresql://vacinekids:vacinekids_dev@localhost:5432/vacinekids_demo?schema=integration_test
FRONTEND_URL=http://localhost:5173
# Exact origin only: no trailing slash, path, query or credentials.
# Future same-site HTTPS production: https://app.example.com (API: https://api.example.com).
# Cookie Secure/name are derived from NODE_ENV; no shared secret or JWT is needed.

# Used only by docker-compose.yml. Keep real hosted credentials out of this file.
POSTGRES_PORT=5432
POSTGRES_USER=vacinekids
POSTGRES_PASSWORD=vacinekids_dev
POSTGRES_DB=vacinekids_demo
