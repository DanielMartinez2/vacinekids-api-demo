NODE_ENV=development
PORT=3001
# Application, development seed and local API data.
DATABASE_URL=postgresql://vacinekids:vacinekids_dev@localhost:5432/vacinekids_demo?schema=public
# Integration tests only. The runner requires this isolated schema explicitly.
TEST_DATABASE_URL=postgresql://vacinekids:vacinekids_dev@localhost:5432/vacinekids_demo?schema=integration_test
FRONTEND_URL=http://localhost:5173

# Used only by docker-compose.yml. Keep real hosted credentials out of this file.
POSTGRES_PORT=5432
POSTGRES_USER=vacinekids
POSTGRES_PASSWORD=vacinekids_dev
POSTGRES_DB=vacinekids_demo
